# Theme — Catppuccin Latte (catppuccin.com/palette). Values are the
# palette's hex codes, inlined by hand since sway config doesn't support
# variables/includes of JSON — see docs/theming.md for the full picture
# across apps.

gaps inner 6
gaps outer 3
default_border pixel 1
smart_borders on
font pango:Iosevka Nerd Font Regular 10

# Procedurally generated Catppuccin Latte gradient (see
# dotfiles/wallpaper/generate.sh) — falls back to a flat fill (same "solid
# bg" approach as the Windows wallpaper) if this ever needs reverting:
#   exec swaybg -c "#eff1f5"
exec swaybg -i /home/santi/.local/share/wallpaper/catppuccin-latte.png -m fill

for_window [shell="xdg_shell"] title_format "%title (%app_id)"
for_window [shell="x_wayland"] title_format "%class - %title"

#                       border  bground text    indicator child_border
client.focused          #fe640b #fe640b #eff1f5 #fe640b   #fe640b
client.focused_inactive #acb0be #acb0be #4c4f69 #acb0be   #acb0be
client.unfocused        #bcc0cc #bcc0cc #5c5f77 #bcc0cc   #bcc0cc
client.urgent           #d20f39 #d20f39 #eff1f5 #d20f39   #d20f39
client.placeholder      #bcc0cc #eff1f5 #4c4f69 #bcc0cc   #bcc0cc
client.background       #eff1f5

bar {
    swaybar_command waybar
}
