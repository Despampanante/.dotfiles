// Minimal niri config — first draft, not battle-tested. Niri's config
// isn't validated at Nix-build time (it's a plain symlinked file, not
// parsed by Nix), so check it after first login with:
//   niri validate -c ~/.config/niri/config.kdl
// Keybinds loosely mirror the sway config's spirit (mod+d launcher,
// mod+Return terminal, mod+hjkl navigation) adapted to niri's
// scrollable-column model instead of sway's split/stack model — see
// DECISIONS.md.

input {
    keyboard {
        xkb {
            layout "us"
            // Sway already has this via caps:ctrl_modifier in
            // config.d/input; niri never got the equivalent, so Caps Lock
            // did nothing extra here. This makes it act as an additional
            // left-Ctrl while held (not a swap/toggle).
            options "caps:ctrl_modifier"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 12
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    // `focus-ring` only wraps the focused window (its inactive-color is
    // for a focused window on an unfocused monitor, not regular inactive
    // windows) -- `border` is niri's actual per-window decoration with
    // real active/inactive states, so that's what draws on every window.
    focus-ring {
        off
    }

    border {
        width 2
        active-color "#fe640b"
        inactive-color "#acb0be"
    }
}

prefer-no-csd

// Named/static workspaces -- unlike the plain numbered slots below (which
// are fully dynamic and get garbage-collected when emptied, so what
// "position 3" means can drift), a declared `workspace "name"` always
// exists at a fixed spot even with no windows on it. Named "w1".."w0"
// rather than bare "1".."0": confirmed live (`niri msg action
// focus-workspace "1"` then checking `niri msg workspaces`) that a plain
// digit string is resolved as a *positional index*, not looked up by
// name, regardless of any workspace actually named that -- so bare-digit
// names silently defeated the entire point of this block (every bind
// below was still following raw position, not the named workspace).
// The "w" prefix makes the string unparseable as an index, forcing an
// actual name lookup. Corresponds to the digits picked as easiest to
// reach on the keyboard (123 7890, skipping the 456 row); 4/5 included
// too so every digit in binds below addresses a workspace by name
// consistently rather than a mix of named and positional.
//
// On-screen left-to-right/top-to-bottom order is a separate question from
// this list's declaration order -- unclear from testing tonight whether
// it's driven by declaration order at all, since a prior attempt at
// reordering this block produced no visible change on an already-running
// session. Left in plain ascending order here; revisit the *display*
// order (not the keybind correctness, which this fix covers) after a
// full logout confirms whether it needs its own fix.
workspace "w1"
workspace "w2"
workspace "w3"
workspace "w4"
workspace "w5"
workspace "w7"
workspace "w8"
workspace "w9"
workspace "w0"

// Pins each app to its workspace regardless of how the window was
// created -- covers both the spawn-at-startup launches below and any
// later manual launch (e.g. via fuzzel). If the named workspace above
// didn't exist, this would silently fall back to opening on whatever's
// currently focused -- see DECISIONS.md.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    open-on-workspace "w1"
}
window-rule {
    match app-id="^google-chrome$"
    open-on-workspace "w2"
}
window-rule {
    match app-id="^discord$"
    open-on-workspace "w9"
}
window-rule {
    match app-id="^Spotify$"
    open-on-workspace "w0"
}

// Niri has no built-in Xwayland support (unlike sway, which gets it for
// free from wlroots) -- without this, X11-only apps just fail to open
// under a niri session. xwayland-satellite bridges the gap; it sets
// $DISPLAY itself once running, no extra env wiring needed here.
spawn-at-startup "xwayland-satellite"

// Procedurally generated Catppuccin Latte gradient (see
// dotfiles/wallpaper/generate.sh) — falls back to a flat fill (same
// "solid bg" approach as the Windows wallpaper) if this ever needs
// reverting: spawn-at-startup "swaybg" "-c" "#eff1f5"
spawn-at-startup "swaybg" "-i" "/home/santi/.local/share/wallpaper/catppuccin-latte.png" "-m" "fill"
spawn-at-startup "waybar" "-c" "/home/santi/.config/waybar/config-niri" "-s" "/home/santi/.config/waybar/style.css"
spawn-at-startup "swaync"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// Auto-launched at login instead of by hand -- lands on their pinned
// workspace via the window-rules above regardless of launch order/timing.
// Not wezterm: a terminal auto-spawning every login isn't wanted, unlike
// these three which are meant to just always be running in the background.
spawn-at-startup "discord"
spawn-at-startup "spotify"
spawn-at-startup "google-chrome"

// Night light -- wlroots' own gamma-control protocol, same as sway's copy
// of this in config.d/autostart. No location configured, so it runs on a
// fixed clock instead of real sunrise/sunset -- see DECISIONS.md.
spawn-at-startup "wlsunset" "-S" "07:00" "-s" "19:30" "-t" "3500" "-T" "6500"

// Idle lock -- sway has had this via swayidle in config.d/keybindings all
// along; niri never got the equivalent, so the session just stayed
// unlocked indefinitely. Same timings, swapped sway's `swaymsg "output *
// power off/on"` for niri's own `niri msg action power-off/on-monitors`.
spawn-at-startup "swayidle" "-w" \
    "timeout" "600" "swaylock -f -C /home/santi/.config/swaylock/config" \
    "timeout" "900" "niri msg action power-off-monitors" \
    "resume" "niri msg action power-on-monitors" \
    "before-sleep" "swaylock -f -C /home/santi/.config/swaylock/config"

// wob has no systemd session integration set up here (nothing else in this
// config is systemd-activated either), so it's spawned directly, reading
// off a FIFO we create ourselves instead of wob's usual socket unit.
spawn-sh-at-startup "mkfifo -m 600 \"$XDG_RUNTIME_DIR/wob.sock\" 2>/dev/null; tail -f \"$XDG_RUNTIME_DIR/wob.sock\" | wob"

binds {
    Mod+Return { spawn "wezterm"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
    Mod+Escape { spawn "swaylock" "-f" "-C" "/home/santi/.config/swaylock/config"; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    // Quoted -- these address the named/static workspaces declared above
    // by name, not position, so they can't drift even as other, unnamed
    // dynamic workspaces get created/GC'd around them. 6 was never bound
    // (not in the "easiest to hit" set) and stays that way.
    Mod+1 { focus-workspace "w1"; }
    Mod+2 { focus-workspace "w2"; }
    Mod+3 { focus-workspace "w3"; }
    Mod+4 { focus-workspace "w4"; }
    Mod+5 { focus-workspace "w5"; }
    Mod+7 { focus-workspace "w7"; }
    Mod+8 { focus-workspace "w8"; }
    Mod+9 { focus-workspace "w9"; }
    Mod+0 { focus-workspace "w0"; }
    Mod+Shift+1 { move-window-to-workspace "w1"; }
    Mod+Shift+2 { move-window-to-workspace "w2"; }
    Mod+Shift+3 { move-window-to-workspace "w3"; }
    Mod+Shift+4 { move-window-to-workspace "w4"; }
    Mod+Shift+5 { move-window-to-workspace "w5"; }
    Mod+Shift+7 { move-window-to-workspace "w7"; }
    Mod+Shift+8 { move-window-to-workspace "w8"; }
    Mod+Shift+9 { move-window-to-workspace "w9"; }
    Mod+Shift+0 { move-window-to-workspace "w0"; }

    // Still useful for any *further* overflow beyond the 9 named
    // workspaces above -- niri keeps exactly one empty dynamic workspace
    // at the end of the per-monitor stack; scrolling past it with
    // focus-workspace-down is what grows the list further.
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+Page_Down { move-window-to-workspace-down; }
    Mod+Shift+Page_Up { move-window-to-workspace-up; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+Space { toggle-window-floating; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "/home/santi/.config/scripts/wob-volume.sh" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "/home/santi/.config/scripts/wob-volume.sh" "down"; }
    XF86AudioMute allow-when-locked=true { spawn "/home/santi/.config/scripts/wob-volume.sh" "mute"; }
    XF86MonBrightnessUp { spawn "/home/santi/.config/scripts/wob-brightness.sh" "up"; }
    XF86MonBrightnessDown { spawn "/home/santi/.config/scripts/wob-brightness.sh" "down"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+O { spawn "firefox"; }
}
