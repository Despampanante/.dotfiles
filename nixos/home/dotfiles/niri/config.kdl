// Minimal niri config — first draft, not battle-tested. Niri's config
// isn't validated at Nix-build time (it's a plain symlinked file, not
// parsed by Nix), so check it after first login with:
//   niri validate -c ~/.config/niri/config.kdl
// Keybinds loosely mirror the sway config's spirit (mod+d launcher,
// mod+Return terminal, mod+hjkl navigation) adapted to niri's
// scrollable-column model instead of sway's split/stack model — see
// DECISIONS.md.

input {
    keyboard {
        xkb {
            layout "us"
            // Sway already has this via caps:ctrl_modifier in
            // config.d/input; niri never got the equivalent, so Caps Lock
            // did nothing extra here. This makes it act as an additional
            // left-Ctrl while held (not a swap/toggle).
            options "caps:ctrl_modifier"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 12
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    // `focus-ring` only wraps the focused window (its inactive-color is
    // for a focused window on an unfocused monitor, not regular inactive
    // windows) -- `border` is niri's actual per-window decoration with
    // real active/inactive states, so that's what draws on every window.
    focus-ring {
        off
    }

    border {
        width 2
        active-color "#fe640b"
        inactive-color "#acb0be"
    }
}

prefer-no-csd

// Niri has no built-in Xwayland support (unlike sway, which gets it for
// free from wlroots) -- without this, X11-only apps just fail to open
// under a niri session. xwayland-satellite bridges the gap; it sets
// $DISPLAY itself once running, no extra env wiring needed here.
spawn-at-startup "xwayland-satellite"

// Procedurally generated Catppuccin Latte gradient (see
// dotfiles/wallpaper/generate.sh) — falls back to a flat fill (same
// "solid bg" approach as the Windows wallpaper) if this ever needs
// reverting: spawn-at-startup "swaybg" "-c" "#eff1f5"
spawn-at-startup "swaybg" "-i" "/home/santi/.local/share/wallpaper/catppuccin-latte.png" "-m" "fill"
spawn-at-startup "waybar" "-c" "/home/santi/.config/waybar/config-niri" "-s" "/home/santi/.config/waybar/style.css"
spawn-at-startup "swaync"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// Night light -- wlroots' own gamma-control protocol, same as sway's copy
// of this in config.d/autostart. No location configured, so it runs on a
// fixed clock instead of real sunrise/sunset -- see DECISIONS.md.
spawn-at-startup "wlsunset" "-S" "07:00" "-s" "19:30" "-t" "3500" "-T" "6500"

// Idle lock -- sway has had this via swayidle in config.d/keybindings all
// along; niri never got the equivalent, so the session just stayed
// unlocked indefinitely. Same timings, swapped sway's `swaymsg "output *
// power off/on"` for niri's own `niri msg action power-off/on-monitors`.
spawn-at-startup "swayidle" "-w" \
    "timeout" "600" "swaylock -f -C /home/santi/.config/swaylock/config" \
    "timeout" "900" "niri msg action power-off-monitors" \
    "resume" "niri msg action power-on-monitors" \
    "before-sleep" "swaylock -f -C /home/santi/.config/swaylock/config"

// wob has no systemd session integration set up here (nothing else in this
// config is systemd-activated either), so it's spawned directly, reading
// off a FIFO we create ourselves instead of wob's usual socket unit.
spawn-sh-at-startup "mkfifo -m 600 \"$XDG_RUNTIME_DIR/wob.sock\" 2>/dev/null; tail -f \"$XDG_RUNTIME_DIR/wob.sock\" | wob"

binds {
    Mod+Return { spawn "wezterm"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
    Mod+Escape { spawn "swaylock" "-f" "-C" "/home/santi/.config/swaylock/config"; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }

    // `focus-workspace <n>` (above) only jumps to whatever already occupies
    // that position -- it never creates one. Niri keeps exactly one empty
    // workspace at the end of the per-monitor stack; scrolling past it with
    // focus-workspace-down is what actually grows the list. This is the
    // "native" way to get more than however many workspaces already exist,
    // instead of a fixed count like sway's numbered workspaces.
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+Page_Down { move-window-to-workspace-down; }
    Mod+Shift+Page_Up { move-window-to-workspace-up; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+Space { toggle-window-floating; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "/home/santi/.config/scripts/wob-volume.sh" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "/home/santi/.config/scripts/wob-volume.sh" "down"; }
    XF86AudioMute allow-when-locked=true { spawn "/home/santi/.config/scripts/wob-volume.sh" "mute"; }
    XF86MonBrightnessUp { spawn "/home/santi/.config/scripts/wob-brightness.sh" "up"; }
    XF86MonBrightnessDown { spawn "/home/santi/.config/scripts/wob-brightness.sh" "down"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+O { spawn "firefox"; }
}
