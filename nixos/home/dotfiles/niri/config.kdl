// Minimal niri config — first draft, not battle-tested. Niri's config
// isn't validated at Nix-build time (it's a plain symlinked file, not
// parsed by Nix), so check it after first login with:
//   niri validate -c ~/.config/niri/config.kdl
// Keybinds loosely mirror the sway config's spirit (mod+d launcher,
// mod+Return terminal, mod+hjkl navigation) adapted to niri's
// scrollable-column model instead of sway's split/stack model — see
// DECISIONS.md.

input {
    keyboard {
        xkb {
            layout "us"
            // Sway already has this via caps:ctrl_modifier in
            // config.d/input; niri never got the equivalent, so Caps Lock
            // did nothing extra here. This makes it act as an additional
            // left-Ctrl while held (not a swap/toggle).
            options "caps:ctrl_modifier"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

// Physical layout, left to right: Samsung LS27A600U (DP-2) -- GIGABYTE M27Q
// (HDMI-A-1, the main/center monitor) -- laptop panel (eDP-2) on the right.
// Positions are logical (scale-adjusted) pixels, so each monitor's x is the
// sum of the widths of everything to its left. HDMI-A-1 is pinned to its
// 144Hz mode explicitly -- niri's EDID-preferred mode for that panel is
// only 60Hz.
output "DP-2" {
    position x=0 y=0
}

// focus-at-startup: without this, niri focuses whichever output sorts
// first by name (alphabetical among DP-2/HDMI-A-1/eDP-2), which landed on
// the laptop panel -- not this monitor -- and made everything spawned at
// login (fuzzel, the window-switcher) pop up there instead of here.
output "HDMI-A-1" {
    position x=2560 y=0
    mode "2560x1440@143.856"
    focus-at-startup
}

output "eDP-2" {
    position x=5120 y=0
}

layout {
    gaps 12
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    // `focus-ring` only wraps the focused window (its inactive-color is
    // for a focused window on an unfocused monitor, not regular inactive
    // windows) -- `border` is niri's actual per-window decoration with
    // real active/inactive states, so that's what draws on every window.
    focus-ring {
        off
    }

    border {
        width 2
        active-color "#7287fd"
        inactive-color "#acb0be"
    }
}

prefer-no-csd

// No named/static workspaces here on purpose -- a declared `workspace
// "name"` always resolves to one specific, fixed output (see
// `open-on-output` in niri's docs), which is the opposite of what's
// wanted: Mod+1..0 below use bare digit strings, which niri resolves as
// *positional* indices on whichever output currently has focus, so the
// same keybind reaches a different, monitor-local workspace depending on
// where you are. The tradeoff is that jumping straight to an index that
// output hasn't grown to yet (e.g. Mod+5 on a monitor that's only ever
// had 2 workspaces) is a no-op -- Mod+D/Mod+U below grow the stack one
// at a time if that happens.
//
// No `match` -- applies to every window. Confirmed live that this was
// actually needed: spawning a new window pinned to a different (not
// currently visible) workspace left focus on whatever was already
// focused instead of jumping to the new one, e.g. launching something
// via fuzzel while on the terminal's workspace didn't bring it into
// view. niri's default is to auto-focus "most" new windows but not
// all (depends on activation-token details of how it was spawned) --
// this forces it unconditionally rather than depending on that.
window-rule {
    open-focused true
}

// Also match-less -- every new tiled window opens as a full-width
// (maximized) column instead of the default 0.5 proportion from the
// layout block below, rather than needing Mod+F by hand each time.
window-rule {
    open-maximized true
}

// Rounded window corners, matching the pill-radius look used elsewhere in
// the desktop theme. geometry-corner-radius alone only rounds the
// border/focus-ring decoration, not the window's actual content -- needs
// clip-to-geometry true alongside it to round (and clip client-side
// shadows off) the window itself too.
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Required by DankMaterialShell on niri (per its compositor-setup docs):
// its panels (bar, control center, spotlight launcher, lock screen) are
// layer-shell surfaces under the "quickshell" namespace, and without
// this they don't get positioned/backdrop-layered correctly relative to
// regular tiled windows.
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

// Same DMS docs -- floats any stray quickshell toplevel instead of
// letting the blanket open-maximized window-rule below tile it.
window-rule {
    match app-id="org.quickshell$"
    open-floating true
}

// Niri has no built-in Xwayland support (unlike sway, which gets it for
// free from wlroots) -- without this, X11-only apps just fail to open
// under a niri session. xwayland-satellite bridges the gap; it sets
// $DISPLAY itself once running, no extra env wiring needed here.
spawn-at-startup "xwayland-satellite"

// Procedurally generated Catppuccin Latte gradient (see
// dotfiles/wallpaper/generate.sh) — falls back to a flat fill (same
// "solid bg" approach as the Windows wallpaper) if this ever needs
// reverting: spawn-at-startup "swaybg" "-c" "#eff1f5"
spawn-at-startup "swaybg" "-i" "/home/santi/.local/share/wallpaper/catppuccin-latte.png" "-m" "fill"

spawn-at-startup "nm-applet" "--indicator"
// The real polkit-gnome-authentication-agent-1 binary lives under a
// /nix/store/<hash>-.../libexec path that changes every build, so this
// spawns a fixed-name wrapper (see the `polkitAgentWrapper` derivation in
// home/santi.nix) instead of trying to hardcode a real path here -- the
// old hardcoded /usr/lib/polkit-gnome/... path never existed on NixOS at
// all, so this agent was silently never running before.
spawn-at-startup "polkit-agent-wrapper"

// discord/spotify/google-chrome/obsidian used to be force-spawned here
// unconditionally every login. Now that nirinit (services.nirinit in
// configuration.nix) actually restores real session state, that's
// redundant -- nirinit brings them back if they were open when the
// session was last saved, which is the common case, without forcing
// them open on logins where they weren't wanted. Tradeoff accepted: on
// a genuinely first-ever login (or if the saved session is stale/empty --
// see the nirinit bootstrap-race note in configuration.nix), nothing
// launches these automatically anymore; that's a one-time manual relaunch
// instead of a silent guarantee. See DECISIONS.md.

// Night light -- wlroots' own gamma-control protocol. Real lat/long for
// Arlington, VA (not GPS-aware -- would need manual adjustment during
// extended stretches elsewhere, e.g. Long Island) instead of the earlier
// fixed 7am/7:30pm clock, now that there's a real, known location -- see
// DECISIONS.md.
spawn-at-startup "wlsunset" "-l" "38.88" "-L" "-77.10" "-t" "3500" "-T" "6500"

// Idle lock -- handled by DankMaterialShell's own idle detection +
// auto-lock (home/santi.nix's `programs.dank-material-shell`), which has
// no equivalent timeout/power-off knobs here in config.kdl -- those get
// set once, live, through DMS's own settings panel after first login.
// Known risk accepted here: DMS's niri lockscreen has an open, unfixed
// upstream bug where unlock can stall, worse on multi-monitor setups
// like this one (AvengeMedia/DankMaterialShell#2138).

// wob has no systemd session integration set up here (nothing else in this
// config is systemd-activated either), so it's spawned directly, reading
// off a FIFO we create ourselves instead of wob's usual socket unit.
spawn-sh-at-startup "mkfifo -m 600 \"$XDG_RUNTIME_DIR/wob.sock\" 2>/dev/null; tail -f \"$XDG_RUNTIME_DIR/wob.sock\" | wob"

binds {
    Mod+Return { spawn "ghostty"; }
    // fuzzel -> DMS's spotlight launcher. Old bind kept alongside,
    // commented, for an easy revert:
    // Mod+Space { spawn "fuzzel"; }
    Mod+Space { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+Tab { spawn "/home/santi/.config/scripts/window-switcher.sh"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
    // DMS's lock screen -- see the idle-lock comment further down for
    // the known niri+multi-monitor unlock-stall bug this accepts.
    Mod+Escape { spawn "dms" "ipc" "call" "lock" "lock"; }
    // DMS's floating panels -- the actual point of this migration (see
    // DECISIONS.md): control-center covers network/bluetooth/audio,
    // notifications is the notification center.
    Mod+C { spawn "dms" "ipc" "call" "control-center" "toggle"; }
    Mod+N { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    // Switch focus between physical monitors -- left/right only since the
    // three-monitor layout above (see the output blocks near the top) is
    // horizontal: DP-2 left, HDMI-A-1 center, eDP-2 laptop right. Mod+Ctrl
    // rather than a bare direction since H/L/J/K are already column/window
    // focus above.
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }

    Mod+Ctrl+Shift+H { move-window-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-window-to-monitor-right; }

    // Bare, *unquoted* numbers -- niri's KDL parser treats a quoted
    // "1" as a workspace *name* lookup (which fails silently, since
    // nothing is named that) versus an unquoted 1 as a positional
    // *index* on whichever monitor currently has focus. Mod+1 on the
    // laptop and Mod+1 on the center monitor are two different,
    // monitor-local workspaces. 0 maps to index 10, matching the usual
    // i3/sway "0 comes after 9" convention.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    // Still useful for reaching indices the current monitor hasn't grown
    // to yet (the digit binds above are a no-op past the end of that
    // output's stack) -- niri keeps exactly one empty dynamic workspace
    // at the end of the per-monitor stack; scrolling past it with
    // focus-workspace-down is what grows the list further.
    //
    // Neovim's Ctrl+D/Ctrl+U (half-page down/up) mnemonic, not niri's
    // default Page_Down/Page_Up -- D/U reads the same "down/up" way
    // Ctrl+D/Ctrl+U does, and stays on the home row next to the
    // H/J/K/L column/window nav above instead of a reach to Page_Down.
    // Freed up by moving fuzzel from Mod+D to Mod+Space (see spawns above).
    Mod+D { focus-workspace-down; }
    Mod+U { focus-workspace-up; }
    Mod+Shift+D { move-window-to-workspace-down; }
    Mod+Shift+U { move-window-to-workspace-up; }

    // Jump back to whichever workspace you were on before this one, toggling
    // back and forth on repeat presses -- niri's own default config suggests
    // Mod+Tab for this, but that's already the quick-switcher here.
    Mod+Backspace { focus-workspace-previous; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+Space { toggle-window-floating; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Tabs: stack windows into one column, then show that column as a real
    // tab bar instead of a vertical split. Same keys as niri's own default
    // config, not invented -- consume/expel move a window in and out of the
    // focused column; the bracket binds are the "smart" bidirectional
    // versions (consume from that side if alone, expel that way if already
    // grouped) so you often only need one hand for the whole workflow.
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+W { toggle-column-tabbed-display; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "/home/santi/.config/scripts/wob-volume.sh" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "/home/santi/.config/scripts/wob-volume.sh" "down"; }
    XF86AudioMute allow-when-locked=true { spawn "/home/santi/.config/scripts/wob-volume.sh" "mute"; }
    XF86MonBrightnessUp { spawn "/home/santi/.config/scripts/wob-brightness.sh" "up"; }
    XF86MonBrightnessDown { spawn "/home/santi/.config/scripts/wob-brightness.sh" "down"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+O { spawn "firefox"; }
}
